<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us - Portal Berita Kampus</title>
    <link rel="stylesheet" href="style_boxx.css">
    <style>
        /* CSS Tambahan khusus Form Kontak */
        .form-group {
            margin-bottom: 15px;
        }
        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: 600;
        }
        .form-group input, 
        .form-group textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #cbd5e1;
            border-radius: 4px;
            box-sizing: border-box;
            font-family: inherit;
        }
        .btn-submit {
            background-color: #0f766e;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 600;
        }
        .btn-submit:hover {
            background-color: #115e59;
        }
    </style>
</head>
<body>
    <div id="container">
        <header>
            <h1>Portal Berita Utama</h1>
        </header>

        <nav>
            <a href="lab4_boxx.html">Beranda</a>
            <a href="#">Berita Terbaru</a>
            <a href="about.html">Tentang Kami</a>
            <a href="kontak.html" class="active">Hubungi Kami</a>
        </nav>

        <section id="wrapper">
            <section id="main">
                <h2>Formulir Kontak</h2>
                <br>
                <form action="#" method="post">
                    <div class="form-group">
                        <label for="nama">Nama Lengkap:</label>
                        <input type="text" id="nama" name="nama" placeholder="Masukkan nama Anda..." required>
                    </div>
                    <div class="form-group">
                        <label for="email">Alamat Email:</label>
                        <input type="email" id="email" name="email" placeholder="Masukkan email Anda..." required>
                    </div>
                    <div class="form-group">
                        <label for="pesan">Pesan / Pertanyaan:</label>
                        <textarea id="pesan" name="pesan" rows="5" placeholder="Tuliskan pesan Anda di sini..." required></textarea>
                    </div>
                    <button type="submit" class="btn-submit">Kirim Pesan</button>
                </form>
            </section>

            <aside id="sidebar">
                <div class="widget-box">
                    <h3 class="title">Bantuan</h3>
                    <p>Silakan isi formulir di samping jika Anda memiliki pertanyaan atau kendala seputar praktikum.</p>
                </div>
            </aside>
        </section>

        <footer>
            <p>&copy; 2026 - Laboratorium Komputer Fakultas Ilmu Komputer</p>
        </footer>
    </div>
</body>
</html>
