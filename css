/* Import Google Font */
@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap');

/* Reset CSS */
* {
    margin: 0;
    padding: 0;
}

body {
    line-height: 1.5;
    font-size: 100%;
    font-family: 'Poppins', sans-serif;
    color: #334155;
    background-color: #f1f5f9;
}

#container {
    width: 980px;
    margin: 20px auto;
    background-color: #ffffff;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.08);
}

/* Header */
header {
    padding: 25px 20px;
    background-color: #ffffff;
}

header h1 {
    margin: 10px;
    color: #0f766e;
    font-weight: 700;
}

/* Navigasi */
nav {
    display: block;
    background-color: #0f766e;
}

nav a {
    padding: 15px 30px;
    display: inline-block;
    color: #ffffff;
    font-size: 14px;
    text-decoration: none;
    font-weight: 600;
}

nav a.active,
nav a:hover {
    background-color: #115e59;
}

/* Hero Panel */
#hero {
    background-color: #ccfbf1;
    padding: 50px 30px;
    margin-bottom: 20px;
    border-left: 6px solid #0d9488;
}

#hero h1 {
    margin-bottom: 15px;
    font-size: 32px;
    color: #134e4a;
}

#hero p {
    margin-bottom: 20px;
    font-size: 16px;
    line-height: 26px;
    color: #115e59;
}

#hero a.btn {
    display: inline-block;
    padding: 10px 20px;
    background-color: #0d9488;
    color: #ffffff;
    text-decoration: none;
    border-radius: 4px;
    font-weight: 600;
}

#hero a.btn:hover {
    background-color: #0f766e;
}

/* Main Content */
#wrapper {
    margin: 0;
}

#main {
    float: left;
    width: 640px;
    padding: 20px;
    box-sizing: border-box;
}

/* Sidebar Area */
#sidebar {
    float: left;
    width: 260px;
    padding: 20px;
    box-sizing: border-box;
}

/* Widget */
.widget-box {
    border: 1px solid #e2e8f0;
    margin-bottom: 20px;
    border-radius: 6px;
    overflow: hidden;
}

.widget-box .title {
    padding: 12px 16px;
    background-color: #0284c7;
    color: #ffffff;
    font-size: 16px;
}

.widget-box ul {
    list-style-type: none;
}

.widget-box li {
    border-bottom: 1px solid #f1f5f9;
}

.widget-box li a {
    padding: 12px 16px;
    color: #475569;
    display: block;
    text-decoration: none;
    font-size: 14px;
}

.widget-box li:hover a {
    background-color: #f0f9ff;
    color: #0284c7;
}

.widget-box p {
    padding: 15px;
    line-height: 22px;
    font-size: 14px;
    color: #64748b;
}

/* Box & Row */
.box {
    display: block;
    float: left;
    width: 50%;
    box-sizing: border-box;
    padding: 0 10px;
    text-align: center;
}

.box h3 {
    margin: 15px 0 10px 0;
    color: #1e293b;
}

.box p {
    line-height: 22px;
    font-size: 14px;
    margin-bottom: 15px;
    color: #64748b;
}

.box img {
    border: 0;
    vertical-align: middle;
}

.box a.btn-default {
    display: inline-block;
    padding: 8px 16px;
    background-color: #e2e8f0;
    color: #334155;
    text-decoration: none;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 600;
}

.box a.btn-default:hover {
    background-color: #cbd5e1;
}

.image-circle {
    border-radius: 50%;
}

.row {
    margin: 0 -10px;
    box-sizing: border-box;
}

.row:after, .row:before,
.entry:after, .entry:before {
    content: " ";
    display: table;
}

.row:after,
.entry:after {
    clear: both;
}

.divider {
    border: 0;
    border-top: 1px solid #e2e8f0;
    margin: 35px 0;
}

/* Entry/Artikel */
.entry {
    margin: 15px 0;
}

.entry h2 {
    margin-bottom: 15px;
    color: #0f172a;
    font-size: 20px;
}

.entry p {
    line-height: 24px;
    font-size: 14px;
    color: #475569;
}

.entry img {
    float: left;
    border-radius: 8px;
    margin-right: 15px;
}

.entry .right-img {
    float: right;
    margin-right: 0;
    margin-left: 15px;
}

/* Footer */
footer {
    clear: both;
    background-color: #0f172a;
    padding: 25px 20px;
    color: #94a3b8;
    text-align: center;
    font-size: 14px;
}
